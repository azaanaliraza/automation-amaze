---
import SectionHeading from './SectionHeading.astro';
---

<section id="stack" class="relative overflow-hidden border-t border-[#201A14]/10 bg-[#F3EDE0] py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading align="center"
      eyebrow="Channels"
      title="Everything works together, not apart."
      copy="SEO, ads, content, reviews and your booking flow — one system pointed at the same outcome: more patients."
    />

    <div class="reveal relative mx-auto mt-14 max-w-3xl rounded-3xl border border-[#201A14]/10 bg-white p-6 sm:p-10 overflow-hidden">
      <div class="grid-lines absolute inset-0 opacity-70" aria-hidden="true"></div>
      <!-- center -->
      <div class="relative flex flex-col items-center">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 w-full font-mono2 text-[11px] uppercase tracking-[0.14em]">
          {['Google Search','Google Maps','Meta Ads','Instagram','YouTube','TikTok','Website','Reviews','Email'].map((t) => (
            <div class="stack-node flex min-h-[48px] items-center justify-center rounded-xl border border-[#201A14]/12 bg-[#201A14]/[0.04] px-3 py-2.5 text-center leading-snug text-[#201A14]/65 transition-all duration-500">◌ {t}</div>
          ))}
        </div>
        <div class="my-2 flex flex-col items-center" aria-hidden="true">
          <div class="h-6 w-px bg-gradient-to-b from-[#201A14]/20 to-[#8A6A45]"></div>
        </div>
        <div id="stack-core" class="relative z-10 rounded-2xl bg-[#241C13] px-8 py-4 text-center shadow-[0_0_60px_rgba(138,106,69,0.3)]">
          <p class="font-display text-xl font-bold tracking-tight text-[#FAF7F1]">✦ AMAZE GROWTH</p>
          <p class="font-mono2 text-[10px] uppercase tracking-[0.2em] text-[#FAF7F1]/60">attract → convert → retain</p>
        </div>
        <div class="my-2 h-6 w-px bg-gradient-to-b from-[#8A6A45] to-[#201A14]/20" aria-hidden="true"></div>
        <div class="flex flex-wrap justify-center gap-2 font-mono2 text-[11px] uppercase tracking-[0.14em]">
          {['Bookings','Reporting','Follow-up'].map((t) => (
            <div class="stack-node rounded-xl border border-[#8A6A45]/25 bg-[#8A6A45]/[0.06] px-4 py-2.5 text-[#6E5334]/90">→ {t}</div>
          ))}
        </div>
      </div>
      <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-30" aria-hidden="true">
        <defs><pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="rgba(138,106,69,0.25)"/></pattern></defs>
        <rect width="100%" height="100%" fill="url(#dots)" />
      </svg>
    </div>
    <p class="reveal mt-6 text-center font-mono2 text-[11px] uppercase tracking-[0.16em] text-[#201A14]/30">Only channels we actually run are listed — ask us about yours</p>
  </div>
</section>

<script>
      // @ts-nocheck
  (() => {
    const nodes = document.querySelectorAll('.stack-node');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !nodes.length) return;
    let i = 0;
    setInterval(() => {
      nodes.forEach((n, j) => {
        const on = j === i % nodes.length;
        n.style.borderColor = on ? 'rgba(138,106,69,0.6)' : '';
        n.style.color = on ? '#6E5334' : '';
        n.style.boxShadow = on ? '0 0 24px rgba(138,106,69,0.15)' : '';
      });
      i++;
    }, 700);
  })();
</script>
