---
import SectionHeading from './SectionHeading.astro';

const cards = [
  { t: 'Lead Capture', flow: ['Website', 'AI', 'Lead', 'CRM'], d: 'Every visitor question becomes a logged, qualified lead.' },
  { t: 'WhatsApp Booking', flow: ['WhatsApp', 'AI', 'Calendar', 'Confirmed'], d: 'Chat → slot → confirmation without staff touching it.' },
  { t: 'Missed Lead Recovery', flow: ['Missed inquiry', 'AI follow-up', 'Conversation', 'Booking'], d: 'The 11:47 PM message finally gets an answer.' },
  { t: 'Review Request', flow: ['Completed service', 'WhatsApp', 'Review request'], d: 'Happy customers are asked at exactly the right moment.' },
  { t: 'Re-engagement', flow: ['Old customer', 'AI message', 'Conversation', 'New booking'], d: 'Quiet databases wake up and rebook on their own.' },
];
---

<section class="relative overflow-hidden border-t border-[#201A14]/10 bg-[#FAF7F1] py-24 sm:py-32" id="gallery">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Automation gallery"
        title="Miniature systems, running everywhere."
        copy="Each card is a real workflow pattern we deploy. Scroll — they animate like the systems they describe."
      />
      <p class="reveal hidden md:block font-mono2 text-[11px] uppercase tracking-[0.2em] text-[#201A14]/30">Scroll →</p>
    </div>
  </div>
  <div class="mt-10 overflow-x-auto pb-4 snap-x snap-mandatory" id="gallery-scroll">
    <div class="flex gap-4 px-4 sm:px-6 w-max mx-auto max-w-full">
      {cards.map((c, i) => (
        <article class="gal-card snap-start w-[280px] sm:w-[320px] shrink-0 rounded-2xl border border-[#201A14]/10 bg-white p-5 opacity-40 transition-all duration-700" data-tilt>
          <p class="font-mono2 text-[10px] uppercase tracking-[0.2em] text-[#201A14]/35">0{i+1} · Example workflow</p>
          <h3 class="mt-2 font-display text-xl font-semibold tracking-tight">{c.t}</h3>
          <div class="mt-4 rounded-xl bg-[#EDE6D6] border border-[#201A14]/[0.07] p-3.5 font-mono2 text-[11px]">
            {c.flow.map((f, j) => (
              <div>
                <div class:list={["gal-step rounded-lg border px-2.5 py-1.5 transition-all duration-500", j===1 ? "border-[#8A6A45]/40 text-[#6E5334]" : j===c.flow.length-1 ? "bg-[#241C13] border-[#8A6A45] text-[#FAF7F1] font-semibold" : "border-[#201A14]/12 text-[#201A14]/65"]}>{f}</div>
                {j < c.flow.length-1 && <div class="mx-auto h-3 w-px bg-[#201A14]/15" aria-hidden="true"></div>}
              </div>
            ))}
          </div>
          <p class="mt-3 text-[13.5px] leading-relaxed text-[#201A14]/50">{c.d}</p>
        </article>
      ))}
      <a href="#book" class="snap-start grid w-[240px] shrink-0 place-items-center rounded-2xl border border-dashed border-[#8A6A45]/30 bg-[#8A6A45]/[0.04] p-5 text-center">
        <div><p class="font-display text-lg font-semibold text-[#6E5334]">Your workflow here →</p><p class="mt-1 text-[13px] text-[#201A14]/50">Tell us what you do. We'll map it.</p></div>
      </a>
    </div>
  </div>
</section>

<script>
      // @ts-nocheck
  (() => {
    const cards = document.querySelectorAll('.gal-card');
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const card = e.target;
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
        const steps = card.querySelectorAll('.gal-step');
        steps.forEach((s, i) => {
          setTimeout(() => { s.style.boxShadow = '0 0 24px rgba(138,106,69,0.18)'; setTimeout(() => s.style.boxShadow = '', 600); }, i * 350);
        });
      });
    }, { threshold: 0.4 });
    cards.forEach((c) => { c.style.transform = 'translateY(16px)'; io.observe(c); });
  })();
</script>
