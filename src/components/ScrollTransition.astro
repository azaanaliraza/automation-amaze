---
---

<section class="relative bg-[#FAF7F1] py-24 sm:py-36 overflow-hidden" aria-label="The response problem">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 text-center">
    <p class="reveal font-mono2 text-[11px] uppercase tracking-[0.24em] text-[#201A14]/35">The uncomfortable truth</p>
    <h2 data-split class="mt-5 font-display font-semibold tracking-[-0.03em] leading-[1.02] text-[clamp(2.2rem,6vw,4.25rem)]">
      Most businesses don't have a lead problem.
    </h2>
    <p class="reveal mt-6 font-display text-[clamp(1.4rem,3.5vw,2.25rem)] text-[#201A14]/40">Pause.</p>
    <h3 data-split class="mt-4 font-display font-semibold tracking-[-0.03em] text-[clamp(2.2rem,6vw,4.25rem)] text-[#6E5334]">
      They have a response problem.
    </h3>
  </div>

  <div class="mx-auto mt-16 max-w-md px-4 sm:px-6">
    <div class="reveal rounded-3xl border border-[#201A14]/10 bg-white p-6 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)]" id="missed-msg">
      <div class="flex items-center justify-between">
        <p class="font-mono2 text-[12px] tracking-widest text-[#201A14]/40">11:47 PM</p>
        <p class="font-mono2 text-[11px] uppercase tracking-widest text-[#201A14]/30">WhatsApp</p>
      </div>
      <div class="mt-4 rounded-2xl rounded-tl-md bg-[#201A14]/[0.07] border border-[#201A14]/10 px-4 py-3 text-[15px] text-[#201A14]/90">
        Hi, I want to know your prices.
      </div>
      <div class="mt-2 flex justify-end">
        <p class="font-mono2 text-[11px] text-[#201A14]/40">Seen <span class="text-sky-700">✓✓</span></p>
      </div>
      <div id="missed-fade" class="mt-6 space-y-2 opacity-100 transition-opacity duration-1000">
        <div class="flex items-center gap-2 text-[#201A14]/35 text-sm">
          <span class="typing-dot size-1.5 rounded-full bg-[#201A14]/30"></span> Nobody replies…
        </div>
        <div class="h-1.5 rounded-full bg-[#201A14]/10 overflow-hidden">
          <div id="missed-bar" class="h-full w-full origin-left scale-x-100 bg-[#201A14]/25 transition-transform duration-[3000ms] ease-linear"></div>
        </div>
      </div>
      <p id="missed-end" class="mt-6 text-center font-display text-lg text-[#201A14]/0 transition-colors duration-1000">The customer moves on.</p>
    </div>
    <p class="reveal mt-10 text-center font-display text-[clamp(1.8rem,4.5vw,3rem)] font-semibold tracking-tight">We fix that<span class="text-[#6E5334]">.</span></p>
    <p class="reveal mt-3 text-center text-[#201A14]/55 max-w-lg mx-auto">An AI system answers in seconds, qualifies the enquiry, and books the appointment — at 11:47 PM or 11:47 AM.</p>
  </div>
</section>

<script>
      // @ts-nocheck
  (() => {
    const card = document.getElementById('missed-msg');
    const bar = document.getElementById('missed-bar');
    const fade = document.getElementById('missed-fade');
    const end = document.getElementById('missed-end');
    if (!card || !bar) return;
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        requestAnimationFrame(() => {
          bar.style.transform = 'scaleX(0)';
          setTimeout(() => { if (fade) fade.style.opacity = '0.25'; }, 1200);
          setTimeout(() => { if (end) end.style.color = 'rgba(32,26,20,0.8)'; }, 2200);
        });
        io.disconnect();
      });
    }, { threshold: 0.5 });
    io.observe(card);
  })();
</script>
