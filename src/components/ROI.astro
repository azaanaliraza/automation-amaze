---
import SectionHeading from './SectionHeading.astro';
import ROICalculator from './react/ROICalculator.tsx';
---

<section id="roi" class="relative overflow-hidden border-t border-[#201A14]/10 bg-[#F3EDE0] py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading align="center"
      eyebrow="Growth calculator"
      title="What is your clinic leaving on the table?"
      copy="Drag the sliders. These are illustrative estimates based on your inputs — never guarantees, always a starting point for the conversation."
    />
    <div class="reveal mt-10">
      <ROICalculator client:visible />
    </div>
  </div>
</section>
