---
import { FOUNDERS } from '../lib/site.ts';
---

<section id="top" data-gsap-hero class="noise relative overflow-hidden pt-28 sm:pt-36 pb-10 sm:pb-16">
  <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
  <div class="hero-orb animate-drift absolute -top-32 left-1/2 -translate-x-1/2 size-[640px] rounded-full bg-[#8A6A45]/[0.07] blur-[120px]" aria-hidden="true"></div>
  <div class="hero-orb absolute top-40 -left-40 size-[420px] rounded-full bg-[#DCC096]/[0.05] blur-[100px]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
      <div>
        <p class="reveal inline-flex items-center gap-2 rounded-full border border-[#201A14]/10 bg-[#201A14]/[0.04] px-3.5 py-1.5 font-mono2 text-[11px] uppercase tracking-[0.18em] text-[#201A14]/60">
          <span class="size-1.5 rounded-full bg-[#241C13]"></span>
          Healthcare growth agency · UAE clinics
        </p>
        <h1 data-split class="mt-6 font-display font-semibold tracking-[-0.035em] leading-[0.98] text-[clamp(2.5rem,11vw,5.5rem)]">
          We bring patients to healthcare brands.
        </h1>
        <p class="reveal mt-6 max-w-xl text-[16px] sm:text-lg leading-relaxed text-[#201A14]/60" style="--reveal-delay:120ms">
          Growth and marketing for IVF centres, dental clinics, aesthetic practices and medical centres across the UAE — built to fill calendars with the right patients, not just clicks.
        </p>
        <div class="reveal mt-8 flex flex-col sm:flex-row gap-3" style="--reveal-delay:200ms">
          <a href="#contact" data-magnetic class="btn-tactile inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-[#241C13] px-7 py-3 sm:py-3.5 font-semibold text-[#FAF7F1] hover:bg-[#372B1A] hover:shadow-[0_0_40px_rgba(138,106,69,0.35)]">
            Book a Free Growth Call <span class="arr" aria-hidden="true">→</span>
          </a>
          <a href="#results" data-magnetic class="btn-tactile inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full border border-[#201A14]/15 px-7 py-3 sm:py-3.5 text-[#201A14]/85 hover:border-[#201A14]/35 hover:text-[#201A14]">
            <span class="grid size-6 place-items-center rounded-full bg-[#201A14]/10 text-[12px]">▶</span>
            See Our Results
          </a>
        </div>
        <div class="reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono2 text-[11px] uppercase tracking-[0.16em] text-[#201A14]/35" style="--reveal-delay:280ms">
          <span>IVF · Dental</span>
          <span class="text-[#6E5334]/50">/</span>
          <span>Aesthetics · Med centres</span>
          <span class="text-[#6E5334]/50">/</span>
          <span>Dubai · Abu Dhabi · Sharjah</span>
        </div>
      </div>

      <!-- growth dashboard visual -->
      <div class="reveal relative" style="--reveal-delay:150ms">
        <div class="absolute -inset-3 rounded-[24px] border border-[#8A6A45]/10" aria-hidden="true"></div>
        <div class="overflow-hidden rounded-2xl border border-[#201A14]/10 bg-white/90 shadow-[0_40px_100px_-40px_rgba(74,58,35,0.35)] backdrop-blur-xl">
          <div class="flex items-center justify-between border-b border-[#201A14]/10 px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-[#ff5f57]" />
              <span class="size-2.5 rounded-full bg-[#febc2e]" />
              <span class="size-2.5 rounded-full bg-[#28c840]" />
            </div>
            <p class="font-mono2 text-[10px] uppercase tracking-[0.2em] text-[#201A14]/40">patient growth dashboard</p>
            <p class="flex items-center gap-1.5 font-mono2 text-[10px] uppercase tracking-[0.2em] text-[#6E5334]">
              <span class="relative flex size-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#241C13] opacity-60" /><span class="relative inline-flex size-2 rounded-full bg-[#241C13]" /></span>
              Live
            </p>
          </div>

          <div class="p-4 sm:p-5">
            <div class="flex items-end justify-between">
              <div>
                <p class="font-mono2 text-[10px] uppercase tracking-[0.2em] text-[#201A14]/40">New patient enquiries</p>
                <p class="mt-1 font-display text-3xl font-semibold tracking-tight text-[#241C13]">This month</p>
              </div>
              <span class="rounded-full bg-[#8A6A45]/15 px-2.5 py-1 font-mono2 text-[11px] font-semibold text-[#6E5334]">Trending up ↑</span>
            </div>

            <!-- funnel -->
            <div class="mt-5 space-y-3">
              {[
                ['Found you (search + social)', 100],
                ['Visited your page', 68],
                ['Enquired / booked', 41],
                ['Showed up & converted', 33],
              ].map(([label, w], i) => (
                <div>
                  <div class="mb-1.5 flex justify-between text-[13px]">
                    <span class="text-[#201A14]/70">{label}</span>
                    <span class="font-mono2 text-[11px] text-[#6E5334]">{w}%</span>
                  </div>
                  <div class="h-8 overflow-hidden rounded-lg bg-[#201A14]/[0.05]">
                    <div class="h-full rounded-lg bg-gradient-to-r from-[#8A6A45] to-[#DCC096] transition-all duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)]" style={`width:${w}%`}></div>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-4 grid grid-cols-3 gap-2 border-t border-[#201A14]/10 pt-4 font-mono2 text-center">
              {['SEO', 'Paid ads', 'Content'].map((t) => (
                <div class="rounded-lg border border-[#201A14]/10 bg-[#201A14]/[0.03] px-2 py-2 text-[10px] uppercase tracking-wider text-[#201A14]/55">{t}</div>
              ))}
            </div>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-between font-mono2 text-[10px] uppercase tracking-[0.18em] text-[#201A14]/30 px-1">
          <span>Fig. 01 — search → visit → booking</span>
          <span class="text-[#6E5334]/70">3 channels, one system</span>
        </div>
      </div>
    </div>

    <!-- proof strip -->
    <div class="reveal mt-14 grid grid-cols-2 md:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-[#201A14]/10 bg-[#201A14]/10" style="--reveal-delay:100ms">
      {[
        ['Healthcare-only', 'We market clinics — nothing else'],
        ['UAE market', 'Proven with Dubai, Abu Dhabi & Sharjah clinics'],
        ['Full-funnel', 'From first search to booked visit'],
        ['Founder-led', `${FOUNDERS.azaan.name} · ${FOUNDERS.areeb.name}`],
      ].map(([t, s]) => (
        <div class="bg-white px-4 py-4 sm:px-5">
          <p class="font-display font-semibold text-[#6E5334]">{t}</p>
          <p class="mt-1 text-[13px] text-[#201A14]/50 leading-snug">{s}</p>
        </div>
      ))}
    </div>
  </div>

<script>
  // @ts-nocheck
  // Progressive enhancement: GSAP entrance + orb parallax (desktop, motion-safe only)
  (async () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;
    try {
      const { gsap } = await import('gsap');
      const hero = document.querySelector('[data-gsap-hero]');
      if (!hero) return;
      gsap.from(hero.querySelectorAll('h1 .w'), {
        yPercent: 60, opacity: 0, duration: 1.1, stagger: 0.05, ease: 'power4.out', delay: 0.1, clearProps: 'all',
      });
      const orbs = hero.querySelectorAll('.hero-orb');
      hero.addEventListener('mousemove', (e) => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        orbs.forEach((o, i) => gsap.to(o, { x: x * (20 + i * 14), y: y * (16 + i * 10), duration: 1.2, ease: 'power2.out', overwrite: 'auto' }));
      });
    } catch {}
  })();
</script>
</section>
