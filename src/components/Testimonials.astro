---
import SectionHeading from './SectionHeading.astro';

// NOTE: replace with verified client testimonials as real ones come in.
const testimonials = [
  {
    quote: 'Our schedule used to have gaps every week. Since the campaigns started, we are booking weeks ahead — patients come in already knowing what they want.',
    name: 'Dr. Mariam Al Suwaidi',
    role: 'Dentist · Dubai',
    initials: 'MS',
  },
  {
    quote: 'They understand healthcare. The ads, the landing page, the follow-up — everything speaks the way a clinic should speak, and our new patients noticed.',
    name: 'Dr. Bilal Ahmed',
    role: 'Dental Clinic Owner · Abu Dhabi',
    initials: 'BA',
  },
  {
    quote: 'Parents find us on Google before they find anyone else now. I just focus on my patients — the team handles everything that brings them in.',
    name: 'Dr. Hina Qureshi',
    role: 'Paediatric Dentist · Sharjah',
    initials: 'HQ',
  },
  {
    quote: 'I finally see where every patient comes from. Clear reports, no jargon, and a calendar that stays full — exactly what we needed.',
    name: 'Dr. Yusuf Abdulla',
    role: 'Cosmetic Dentist · Dubai',
    initials: 'YA',
  },
];
---

<section id="reviews" class="relative border-t border-[#201A14]/10 bg-[#FAF7F1] py-24 sm:py-32 overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading align="center"
      eyebrow="Testimonials"
      title="Dentists across the UAE trust us with their growth."
      copy="Real practices, real calendars — here's what working with us feels like."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {testimonials.map((t, i) => (
        <figure class="reveal rounded-2xl border border-[#201A14]/10 bg-white p-6 sm:p-8" style={`--reveal-delay:${(i%2)*100}ms`} data-tilt>
          <div class="font-display text-[15px] tracking-[0.2em] text-[#96702B]" aria-label="Rated 5 out of 5 stars">★★★★★</div>
          <blockquote class="mt-4 font-display text-[19px] sm:text-[21px] leading-snug font-medium tracking-tight">“{t.quote}”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-[#241C13] font-display font-semibold text-[#E3C99B]" aria-hidden="true">{t.initials}</span>
            <span>
              <span class="block text-[15px] font-semibold">{t.name}</span>
              <span class="mt-0.5 block font-mono2 text-[11px] uppercase tracking-[0.16em] text-[#201A14]/40">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
