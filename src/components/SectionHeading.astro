---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}
const { eyebrow, title, copy, align = 'left', dark = true } = Astro.props;
---

<div class:list={["max-w-3xl", align === 'center' && "mx-auto text-center"]}>
  <p class:list={["reveal font-mono2 text-[11px] sm:text-xs uppercase tracking-[0.22em] flex items-center gap-2 text-[#6E5334]", align==='center' && "justify-center"]}>
    <span class="inline-block size-1.5 rounded-full bg-current" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 data-split class="mt-4 font-display font-semibold tracking-[-0.03em] leading-[1.02] text-[clamp(2rem,5vw,3.75rem)] text-[#201A14]">
    {title}
  </h2>
  {copy && <p class="reveal mt-5 text-[16px] sm:text-lg leading-relaxed text-[#201A14]/60">{copy}</p>}
</div>
