---
import SectionHeading from './SectionHeading.astro';

const cases = [
  {
    biz: 'Dental Clinic', loc: 'Dubai, UAE', quote: 'Patients now find us first when they search for a dentist in our area.',
    problem: 'Invisible on local search while competitors owned the map pack.',
    system: ['Local SEO', 'Google Business', 'Landing pages', 'Reviews'],
    result: 'Consistent new-patient enquiries from search instead of relying on walk-ins and referrals.',
  },
  {
    biz: 'IVF Centre', loc: 'Abu Dhabi, UAE', quote: 'Our consultation bookings grew without us chasing every lead ourselves.',
    problem: 'High-intent visitors dropped off — no clear path from question to consultation.',
    system: ['Content', 'Meta ads', 'Consultation funnel', 'Retargeting'],
    result: 'An education-first funnel that captures intent early and books consultations respectfully.',
  },
  {
    biz: 'Aesthetic Clinic', loc: 'Sharjah, UAE', quote: 'Our social media finally looks like our brand — and it brings people in.',
    problem: 'Inconsistent content and ads that got clicks but no bookings.',
    system: ['Brand creative', 'Reels', 'Offers', 'Booking flow'],
    result: 'A content engine and retargeting loop that turns interest into booked treatments.',
  },
];
---

<section id="results" class="relative border-t border-[#201A14]/10 bg-[#FAF7F1] py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Results"
      title="Clinics we grow."
      copy="A look at how we work with healthcare brands across the UAE and India — clear problems, clear systems, clear outcomes."
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {cases.map((c, i) => (
        <article class="reveal rounded-2xl border border-[#201A14]/10 bg-white p-6 sm:p-7" style={`--reveal-delay:${i*100}ms`} data-tilt>
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full border border-[#96702B]/40 bg-[#96702B]/10 px-3 py-1 font-mono2 text-[10px] uppercase tracking-[0.16em] text-[#96702B]">Healthcare growth</span>
            <span class="font-mono2 text-[11px] text-[#201A14]/35">{c.loc}</span>
          </div>
          <p class="mt-5 font-display text-[21px] leading-snug font-medium tracking-tight">“{c.quote}”</p>
          <p class="mt-3 text-[14px] text-[#201A14]/50"><span class="text-[#201A14]/75 font-medium">{c.biz}</span></p>

          <div class="mt-5 rounded-xl border border-[#201A14]/[0.07] bg-[#201A14]/[0.02] p-4">
            <p class="text-[13px] text-[#201A14]/55"><span class="text-[#201A14]/80 font-medium">Problem:</span> {c.problem}</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5 font-mono2 text-[10px] uppercase tracking-widest">
              {c.system.map((s) => (<span class="rounded-md border border-[#201A14]/12 px-2 py-1 text-[#201A14]/60">{s}</span>))}
            </div>
            <p class="mt-2.5 text-[13px] text-[#201A14]/55"><span class="text-[#6E5334] font-medium">Result:</span> {c.result}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
