---
import SectionHeading from './SectionHeading.astro';

const cases = [
  {
    biz: 'Dental Clinic', loc: 'Dubai, UAE', quote: 'We stopped manually answering the same appointment questions all day.',
    problem: 'Staff spent hours answering repetitive WhatsApp messages.',
    system: ['WhatsApp', 'AI', 'Google Calendar', 'Follow-ups'],
    result: 'Staff can focus on patients while routine conversations are handled automatically.',
  },
  {
    biz: 'Local Salon', loc: 'Sharjah, UAE', quote: 'Customers move from question to appointment without waiting for staff.',
    problem: 'Customers frequently asked about services and availability.',
    system: ['Instagram/WhatsApp', 'AI', 'Service selection', 'Calendar', 'Booking'],
    result: 'Customers can move from question to appointment without waiting for staff.',
  },
];
---

<section id="work" class="relative border-t border-[#201A14]/10 bg-[#FAF7F1] py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Real businesses, real workflows"
      title="Systems doing the repetitive work."
      copy="Example workflows below — clearly marked until verified client stories are published. No fake logos, no invented numbers."
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      {cases.map((c, i) => (
        <article class="reveal rounded-2xl border border-[#201A14]/10 bg-white p-6 sm:p-8" style={`--reveal-delay:${i*100}ms`} data-tilt>
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full border border-[#96702B]/40 bg-[#96702B]/10 px-3 py-1 font-mono2 text-[10px] uppercase tracking-[0.16em] text-[#96702B]">Example workflow</span>
            <span class="font-mono2 text-[11px] text-[#201A14]/35">{c.loc}</span>
          </div>
          <p class="mt-5 font-display text-[22px] leading-snug font-medium tracking-tight">“{c.quote}”</p>
          <p class="mt-3 text-[14px] text-[#201A14]/50"><span class="text-[#201A14]/75 font-medium">Example Client</span> · {c.biz}</p>

          <div class="mt-6 grid sm:grid-cols-2 gap-3">
            <div class="rounded-xl border border-[#201A14]/10 bg-[#F4EEE1] p-4">
              <p class="font-mono2 text-[10px] uppercase tracking-[0.18em] text-[#201A14]/35 mb-2">Before</p>
              <div class="font-mono2 text-[11px] leading-loose text-[#201A14]/50">WhatsApp<br/>↓ Receptionist<br/>↓ Manual response<br/>↓ Calendar<br/>↓ Booking</div>
            </div>
            <div class="rounded-xl border border-[#8A6A45]/25 bg-[#8A6A45]/[0.05] p-4">
              <p class="font-mono2 text-[10px] uppercase tracking-[0.18em] text-[#6E5334] mb-2">After</p>
              <div class="font-mono2 text-[11px] leading-loose text-[#201A14]/75">WhatsApp<br/>↓ <span class="text-[#6E5334]">AI</span><br/>↓ Calendar<br/>↓ Booking</div>
            </div>
          </div>

          <div class="mt-4 rounded-xl border border-[#201A14]/[0.07] bg-[#201A14]/[0.02] p-4">
            <p class="text-[13px] text-[#201A14]/55"><span class="text-[#201A14]/80 font-medium">Problem:</span> {c.problem}</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5 font-mono2 text-[10px] uppercase tracking-widest">
              {c.system.map((s) => (<span class="rounded-md border border-[#201A14]/12 px-2 py-1 text-[#201A14]/60">{s}</span>))}
            </div>
            <p class="mt-2.5 text-[13px] text-[#201A14]/55"><span class="text-[#6E5334] font-medium">Result:</span> {c.result}</p>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-2 font-mono2 text-center">
            {['[XX]% faster response*', '[XX] hrs saved / week*', '[XX] more qualified leads*'].map((m) => (
              <div class="rounded-lg border border-dashed border-[#201A14]/15 px-2 py-2.5 text-[10px] uppercase tracking-wider text-[#201A14]/35">{m}</div>
            ))}
          </div>
          <p class="mt-2 font-mono2 text-[10px] text-[#201A14]/25">*Client-provided metrics — populated after verification. Example testimonial — replace with verified client testimonial.</p>
        </article>
      ))}
    </div>
  </div>
</section>
