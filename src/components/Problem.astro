---
import SectionHeading from './SectionHeading.astro';

const leak = [
  { label: 'conversations', value: 100, width: 100 },
  { label: 'answered', value: 70, width: 70 },
  { label: 'followed up', value: 45, width: 45 },
  { label: 'qualified', value: 27, width: 27 },
  { label: 'booked', value: 12, width: 12 },
];
const fixed = [
  { label: 'conversations', value: 100, width: 100 },
  { label: 'AI responds', value: 100, width: 100 },
  { label: 'AI qualifies', value: 100, width: 100 },
  { label: 'AI follows up', value: 100, width: 100 },
  { label: 'AI books', value: 100, width: 100 },
];
---

<section class="relative border-t border-[#201A14]/10 bg-[#F3EDE0] py-24 sm:py-32 overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="The leaking bucket"
      title="Every day, conversations slip through the cracks."
      copy="WhatsApp, Instagram, your website, Google, phone — enquiries arrive everywhere. Without a system, most never become customers."
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <!-- without -->
      <div class="reveal rounded-2xl border border-[#201A14]/10 bg-white p-6 sm:p-8" data-tilt>
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] uppercase tracking-[0.2em] text-[#201A14]/40">Without a system</p>
          <span class="rounded-full border border-red-800/30 bg-red-800/10 px-2.5 py-1 font-mono2 text-[10px] uppercase tracking-widest text-red-800">Leaking</span>
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5 font-mono2 text-[10px] uppercase tracking-widest text-[#201A14]/40">
          {['WhatsApp','Instagram','Website','Google','Phone'].map((c) => (
            <span class="rounded-full border border-[#201A14]/10 px-2.5 py-1">{c}</span>
          ))}
        </div>
        <div class="mt-6 space-y-3 funnel" data-funnel="leak">
          {leak.map((row, i) => (
            <div>
              <div class="mb-1.5 flex justify-between text-[13px]">
                <span class="text-[#201A14]/60"><span data-count={row.value}>0</span> {row.label}</span>
                {i > 0 && <span class="font-mono2 text-[11px] text-red-800/70">−{leak[i-1].value - row.value} lost</span>}
              </div>
              <div class="h-9 overflow-hidden rounded-lg bg-[#201A14]/[0.05]">
                <div class="funnel-bar h-full rounded-lg bg-gradient-to-r from-[#201A14]/25 to-[#201A14]/10 transition-all duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)]" style={`width:0%`} data-w={row.width}></div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-5 font-mono2 text-[11px] uppercase tracking-[0.16em] text-[#201A14]/30">Illustrative example — not a performance claim</p>
      </div>

      <!-- with -->
      <div class="reveal rounded-2xl border border-[#8A6A45]/25 bg-gradient-to-b from-[#8A6A45]/[0.07] to-transparent p-6 sm:p-8" style="--reveal-delay:120ms" data-tilt>
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] uppercase tracking-[0.2em] text-[#6E5334]">With Amaze Matrix</p>
          <span class="rounded-full bg-[#241C13] px-2.5 py-1 font-mono2 text-[10px] uppercase tracking-widest text-[#FAF7F1] font-semibold">Captured</span>
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5 font-mono2 text-[10px] uppercase tracking-widest text-[#201A14]/50">
          {['AI responds','AI qualifies','AI follows up','AI books'].map((c) => (
            <span class="rounded-full border border-[#8A6A45]/25 bg-[#8A6A45]/[0.06] px-2.5 py-1 text-[#6E5334]/90">{c}</span>
          ))}
        </div>
        <div class="mt-6 space-y-3 funnel" data-funnel="fixed">
          {fixed.map((row) => (
            <div>
              <div class="mb-1.5 flex justify-between text-[13px]">
                <span class="text-[#201A14]/80"><span data-count={row.value}>0</span> {row.label}</span>
                <span class="font-mono2 text-[11px] text-[#6E5334]">✓ handled</span>
              </div>
              <div class="h-9 overflow-hidden rounded-lg bg-[#201A14]/[0.05]">
                <div class="funnel-bar h-full rounded-lg bg-gradient-to-r from-[#8A6A45] to-[#DCC096] transition-all duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)]" style={`width:0%`} data-w={row.width}></div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-5 font-display font-medium text-[#6E5334]">More opportunities captured — automatically.</p>
      </div>
    </div>
  </div>
</section>

<script>
      // @ts-nocheck
  (() => {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.querySelectorAll('.funnel-bar').forEach((b, i) => {
          setTimeout(() => { b.style.width = b.dataset.w + '%'; }, i * 160);
        });
        io.unobserve(e.target);
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('.funnel').forEach((f) => io.observe(f));
  })();
</script>
