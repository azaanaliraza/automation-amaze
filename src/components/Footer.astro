---
import { WHATSAPP_URL } from '../lib/site.ts';
---

<footer class="relative border-t border-white/10 bg-[#211a12] text-[#f6f0e4]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-14">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-8 place-items-center rounded-lg bg-[#DCC096] text-[#211a12] font-display font-bold text-lg">A</span>
          <span class="font-display font-semibold text-lg">Amaze Matrix</span>
        </div>
        <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-white/55">Healthcare growth &amp; marketing for clinics across the UAE and India — with proven previous work in the UAE market. We bring patients to IVF, dental, aesthetic and medical brands — founded by Azaan Ali Raza &amp; Areeb Ali.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="#contact" class="btn-tactile inline-flex items-center gap-2 rounded-full bg-[#DCC096] text-[#211a12] text-sm font-semibold px-5 py-2.5 hover:bg-[#E8D3AB]">Book a Call <span class="arr">→</span></a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-tactile inline-flex items-center gap-2 rounded-full border border-white/15 text-sm px-5 py-2.5 text-white/85 hover:border-white/30">WhatsApp</a>
      </div>
    </div>
    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-8 text-sm">
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Services</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#services">SEO for Clinics</a></li>
          <li><a class="hover:text-white" href="#services">Paid Advertising</a></li>
          <li><a class="hover:text-white" href="#services">Content &amp; Social</a></li>
          <li><a class="hover:text-white" href="#services">Conversion Websites</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Industries</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#industries">IVF &amp; Fertility</a></li>
          <li><a class="hover:text-white" href="#industries">Dental Clinics</a></li>
          <li><a class="hover:text-white" href="#industries">Aesthetic Clinics</a></li>
          <li><a class="hover:text-white" href="#industries">Medical Centres</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Company</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#results">Results</a></li>
          <li><a class="hover:text-white" href="#reviews">Testimonials</a></li>
          <li><a class="hover:text-white" href="#about">About</a></li>
          <li><a class="hover:text-white" href="#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Connect</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a class="hover:text-white" href="#contact">LinkedIn</a></li>
          <li><a class="hover:text-white" href="#contact">Privacy</a></li>
          <li><a class="hover:text-white" href="#contact">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-[13px] text-white/35">
      <p>© 2026 Amaze Matrix. We bring patients to healthcare brands.</p>
      <p class="font-mono2 text-[11px] uppercase tracking-[0.16em]">Search → Trust → Book → Return → Refer</p>
    </div>
  </div>
</footer>
