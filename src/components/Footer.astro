---
import { WHATSAPP_URL } from '../lib/site.ts';
---

<footer class="relative border-t border-white/10 bg-[#211a12] text-[#f6f0e4]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-14">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-8 place-items-center rounded-lg bg-[#DCC096] text-[#211a12] font-display font-bold text-lg">A</span>
          <span class="font-display font-semibold text-lg">Amaze Matrix</span>
        </div>
        <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-white/55">AI automation for businesses that want to move faster. We turn conversations into booked appointments and qualified customers — automatically.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="#book" class="btn-tactile inline-flex items-center gap-2 rounded-full bg-[#DCC096] text-[#211a12] text-sm font-semibold px-5 py-2.5 hover:bg-[#E8D3AB]">Book a Demo <span class="arr">→</span></a>
        <a href="#demo" class="btn-tactile inline-flex items-center gap-2 rounded-full border border-white/15 text-sm px-5 py-2.5 text-white/85 hover:border-white/30">WhatsApp demo</a>
      </div>
    </div>
    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-8 text-sm">
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Solutions</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#systems">AI Chatbots</a></li>
          <li><a class="hover:text-white" href="#systems">WhatsApp Automation</a></li>
          <li><a class="hover:text-white" href="#systems">Appointment Systems</a></li>
          <li><a class="hover:text-white" href="#systems">Lead Qualification</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Industries</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#industries">Dentists & Clinics</a></li>
          <li><a class="hover:text-white" href="#industries">Salons & Beauty</a></li>
          <li><a class="hover:text-white" href="#industries">Real Estate</a></li>
          <li><a class="hover:text-white" href="#industries">Restaurants & Gyms</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Company</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href="#work">Case Studies</a></li>
          <li><a class="hover:text-white" href="#about">About</a></li>
          <li><a class="hover:text-white" href="#book">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono2 text-[11px] uppercase tracking-[0.18em] text-white/35 mb-4">Connect</p>
        <ul class="space-y-2.5 text-white/65">
          <li><a class="hover:text-white" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a class="hover:text-white" href="#book">LinkedIn</a></li>
          <li><a class="hover:text-white" href="#book">Privacy</a></li>
          <li><a class="hover:text-white" href="#book">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-[13px] text-white/35">
      <p>© 2026 Amaze Matrix. We build AI systems that work while you don't.</p>
      <p class="font-mono2 text-[11px] uppercase tracking-[0.16em]">Message → Understand → Automate → Action → Revenue</p>
    </div>
  </div>
</footer>
