---
import SectionHeading from './SectionHeading.astro';
import LiveDemoChat from './react/LiveDemoChat.tsx';
---

<section id="demo" class="relative overflow-hidden border-t border-[#201A14]/10 bg-[#F3EDE0] py-24 sm:py-32">
  <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading align="center"
      eyebrow="Live demo"
      title="Don't take our word for it. Try the system."
      copy="Pick your business type and run a realistic booking conversation — the same flow your customers would experience."
    />
    <div class="reveal mx-auto mt-10 max-w-2xl">
      <LiveDemoChat client:visible />
    </div>
    <div class="reveal mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 font-mono2 text-[11px] uppercase tracking-[0.16em] text-[#201A14]/35">
      <span>✓ Answers instantly</span><span>✓ Checks availability</span><span>✓ Books + confirms</span><span>✓ Hands off to humans</span>
    </div>
  </div>
</section>
